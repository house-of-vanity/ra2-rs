(
    version: 1,
    arena: (
        title: "RA2 Combat Arena",
        // The normal demo now loads the original BINARY model.
        model: "Arenas/box/boxarena.gmf",
        floor_object: "floor",
        collision_object: "arena_collision",
        robot_spawn: (0.0, 1.1, 8.0),
        friction: 0.8,
        restitution: 0.1,
    ),
    robot: (
        chassis_size: (2.8, 0.7, 3.6),
        chassis_mass: 30.0,
        wheel_mass: 3.0,
        wheel_radius: 0.65,
        wheel_width: 0.5,
        wheel_track: 3.3,
        wheel_base: 2.5,
        axle_height: -0.3,
        motor_speed: 30.0,
        turn_speed: 14.0,
        motor_damping: 60.0,
        motor_force: 360.0,
    ),
    // Havok gameplay units -> Rapier SI tuning, independent of BOT/CFZ data.
    garage: (
        motor_force_scale: 40.0,
        motor_damping: 20.0,
        servo_stiffness: 400.0,
        servo_damping: 35.0,
        strike_speed_scale: 1.35,
        strike_force_scale: 1.6,
        // Native linear impact strength, calibrated for Rapier world units.
        impact_damage_scale: 0.25,
        wheel_drive_acceleration: 8.0,
        wheel_motor_damping: 100.0,
    ),
    rendering: (roughness: 0.85, opacity_map_alpha: 0.18),
    // Visual inspection only: models retain their original transforms and attachment metadata.
    // Uniform display scaling below does not change their imported physical properties.
    showcase: [
        (label: "Air tank", model: "Components/airtank/airtank.gmf", position: (-6.0, 0.4, -2.0), size: 3.0),
        (label: "Wheel", model: "Components/wheel1/wheel1.gmf", position: (0.0, 0.4, -2.0), size: 3.0),
        (label: "Motor", model: "Components/burstmotor/burstmotor.gmf", position: (6.0, 0.4, -2.0), size: 3.0),
    ],
)
